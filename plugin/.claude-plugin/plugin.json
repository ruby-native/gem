{
  "name": "ruby-native",
  "displayName": "Ruby Native",
  "version": "0.18.0",
  "description": "Ship a Rails app to the App Store and Google Play from your coding agent. Every ruby_native command as a tool, and a ship prompt that walks the whole journey.",
  "author": {
    "name": "Joe Masilotti",
    "email": "joe@rubynative.com",
    "url": "https://rubynative.com"
  },
  "homepage": "https://rubynative.com/docs/cli#mcp-server",
  "repository": "https://github.com/ruby-native/gem",
  "license": "MIT",
  "keywords": [
    "rails",
    "ruby",
    "ios",
    "android",
    "app-store",
    "google-play",
    "hotwire-native",
    "mcp"
  ],
  "icon": "./icon.png",
  "documentationUrl": "https://rubynative.com/docs/cli#mcp-server",
  "supportUrl": "https://github.com/ruby-native/gem/issues",
  "privacyPolicyUrl": "https://rubynative.com/privacy",
  "termsOfServiceUrl": "https://rubynative.com/terms",
  "mcpServers": {
    "ruby-native": {
      "command": "bundle",
      "args": [
        "exec",
        "ruby_native",
        "mcp"
      ],
      "env": {
        "RUBY_NATIVE_TOKEN": "${user_config.ruby_native_token}"
      }
    }
  },
  "userConfig": {
    "ruby_native_token": {
      "type": "string",
      "title": "Ruby Native token",
      "description": "Optional. A token from ruby_native login or a CI token from your dashboard. Leave it blank to use the login already stored on this machine.",
      "sensitive": true
    }
  }
}
